{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledgerforge/manifest.schema.json",
  "title": "manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "episode_id",
    "base_currency",
    "currency_exponents",
    "period_start",
    "period_end",
    "timezone",
    "counts",
    "rounding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "generator_version": {
      "type": "string"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "currency_exponents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      }
    },
    "period_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger",
        "invoices",
        "payments",
        "fx"
      ],
      "properties": {
        "ledger": {
          "type": "integer",
          "minimum": 0
        },
        "invoices": {
          "type": "integer",
          "minimum": 0
        },
        "payments": {
          "type": "integer",
          "minimum": 0
        },
        "fx": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rounding": {
      "const": "ROUND_HALF_EVEN"
    }
  }
}
