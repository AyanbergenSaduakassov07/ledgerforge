{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledgerforge/submission.schema.json",
  "title": "submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "findings"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "type": {
            "enum": [
              "duplicate_invoice",
              "payment_allocation",
              "fx_rate",
              "reporting_period"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "claimed_amount_minor": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
